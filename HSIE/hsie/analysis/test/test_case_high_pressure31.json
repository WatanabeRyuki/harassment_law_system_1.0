      {
        "utterance_id": "utt_801",
        "speaker_id": "speaker_1",
        "text": "話せ。",
        "start_time": 0.0,
        "end_time": 2.0
      },
      {
        "utterance_id": "utt_802",
        "speaker_id": "speaker_0",
        "text": "はい、今回のミスは私の確認不足が原因で、提出物に不備がありました。申し訳ありません。",
        "start_time": 3.0,
        "end_time": 14.0
      },
      {
        "utterance_id": "utt_803",
        "speaker_id": "speaker_1",
        "text": "で？",
        "start_time": 15.0,
        "end_time": 16.5
      },
      {
        "utterance_id": "utt_804",
        "speaker_id": "speaker_0",
        "text": "再発防止として、チェックリストを作成し、提出前に必ず確認するようにします。",
        "start_time": 17.5,
        "end_time": 27.0
      },
      {
        "utterance_id": "utt_805",
        "speaker_id": "speaker_1",
        "text": "浅い。",
        "start_time": 28.0,
        "end_time": 29.5
      },
      {
        "utterance_id": "utt_806",
        "speaker_id": "speaker_0",
        "text": "すみません……ではダブルチェック体制も導入します。",
        "start_time": 30.5,
        "end_time": 38.0
      },
      {
        "utterance_id": "utt_807",
        "speaker_id": "speaker_1",
        "text": "違う。",
        "start_time": 39.0,
        "end_time": 40.5
      },
      {
        "utterance_id": "utt_808",
        "speaker_id": "speaker_0",
        "text": "えっと……方向性が違うということでしょうか。",
        "start_time": 41.5,
        "end_time": 47.0
      },
      {
        "utterance_id": "utt_809",
        "speaker_id": "speaker_1",
        "text": "自覚ないんだ。",
        "start_time": 48.0,
        "end_time": 50.0
      },
      {
        "utterance_id": "utt_810",
        "speaker_id": "speaker_0",
        "text": "申し訳ありません……。",
